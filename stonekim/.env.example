# ── 서버 ─────────────────────────────────────────────
PORT=3000
# 고객 업로드 링크에 사용되는 외부 주소 (운영 시 반드시 실제 도메인)
STONEKIM_BASE_URL=https://photo.stonekim.co.kr
# HTTPS 운영 시 세션 쿠키에 Secure 플래그 부여
STONEKIM_SECURE_COOKIE=1

# ── 최초 관리자 계정 (미설정 시 임시 비밀번호가 콘솔에 출력) ──
STONEKIM_ADMIN_USER=admin
STONEKIM_ADMIN_PASSWORD=

# ── 발송 채널: mock | solapi | http ──────────────────
# mock   : 실제 발송 없음 (개발·시연 기본값)
# solapi : 솔라피 알림톡(ATA) + SMS/LMS
# http   : 그 외 사업자용 범용 JSON 엔드포인트
STONEKIM_MSG_PROVIDER=mock

# 공통: 사전 등록된 발신번호 (문자 대체발송용)
STONEKIM_MSG_SENDER=

# 솔라피
STONEKIM_SOLAPI_API_KEY=
STONEKIM_SOLAPI_API_SECRET=
STONEKIM_KAKAO_PFID=
# 승인받은 알림톡 템플릿 코드 (docs/알림톡-템플릿-신청.md 참고)
STONEKIM_TPL_FIRST=
STONEKIM_TPL_SECOND=
STONEKIM_TPL_FINAL=
STONEKIM_LMS_SUBJECT=스톤킴 시공사진 리워드 안내

# 범용 HTTP 게이트웨이 (solapi 외 업체)
STONEKIM_ALIMTALK_ENDPOINT=
STONEKIM_SMS_ENDPOINT=
STONEKIM_MSG_API_KEY=
STONEKIM_ALIMTALK_SENDER_KEY=
STONEKIM_MSG_TIMEOUT_MS=15000

# ── 저장 위치 / 용량 ─────────────────────────────────
STONEKIM_DATA_DIR=./data
STONEKIM_MAX_FILE_BYTES=20971520
STONEKIM_MAX_UPLOAD_BYTES=125829120

# ── 스케줄러 ─────────────────────────────────────────
STONEKIM_TICK_MS=60000
# 알림톡 실패 → 문자 대체발송 경로 점검용 (0~1, mock 전용)
STONEKIM_MOCK_ALIMTALK_FAIL_RATE=0
