# ─────────────────────────────────────────────────────────────
# DADA NAVER ADS AI CONTROL CENTER
# 이 파일을 .env 로 복사해 사용합니다. .env 는 절대 커밋하지 않습니다.
# API Secret 은 코드에 하드코딩하지 않습니다 (§33).
# ─────────────────────────────────────────────────────────────

ENVIRONMENT=local

# PostgreSQL
POSTGRES_USER=dada
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dada_ads
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://dada:change-me@localhost:5432/dada_ads

# NAVER 검색광고 API — READ ONLY (§30)
NAVER_API_BASE_URL=https://api.searchad.naver.com
NAVER_API_KEY=
NAVER_SECRET_KEY=
# "customerId:계정명" 을 쉼표로 나열합니다.
NAVER_CUSTOMER_IDS=1234567:다다그룹,2345678:타임렌탈
NAVER_READ_ONLY=true

# 리포트 정책
CEO_REPORT_MIN_CONFIDENCE=70
DEFAULT_CONTRIBUTION_MARGIN_RATE=0.30

# 스케줄러 (초기에는 APScheduler, 운영에서는 Cron/Worker 로 확장)
ENABLE_SCHEDULER=false
NAVER_SYNC_CRON_HOUR=5
DAILY_REPORT_CRON_HOUR=7

# 프론트엔드
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
